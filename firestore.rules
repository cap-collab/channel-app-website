rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Collection-group read access for the go-live cron. CG queries
    // (from allDescendants) are evaluated against /{path=**}/<collection>/{id}
    // rules — the nested match blocks under /users/{userId} do NOT apply to
    // them, so without these the cron's loveHistory/streamHistory CG queries
    // 403 and every engagement-based recipient is silently dropped.
    match /{path=**}/loveHistory/{djId} {
      allow read: if request.auth != null && request.auth.token.email == 'cron@channel-app.com';
    }
    match /{path=**}/streamHistory/{archiveId} {
      allow read: if request.auth != null && request.auth.token.email == 'cron@channel-app.com';
    }

    // Helper function to check if user is a broadcaster or admin
    function isBroadcaster() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['broadcaster', 'admin'];
    }

    // ── Linked accounts (see src/lib/account-links.ts) ────────────────────────
    // A person may sign in with a SECOND account (e.g. their personal email)
    // that is an ALIAS of their canonical account. An alias is ONLY A LOGIN — a
    // doorway. It holds no identity and no history of its own: signing in with
    // it simply makes you the primary. Its user doc carries `primaryUid`; the
    // primary carries `aliasUids[]`.
    //
    // So an alias must be able to act on the primary's docs — edit the shared
    // profile, manage its recordings, and record its OWN engagement (loves,
    // favorites) onto the primary. Every gate below therefore accepts either the
    // caller's own uid or the primary it resolves to.
    //
    // Cost note: every branch is written so the CHEAP identity check runs first
    // and short-circuits. An unlinked user (the overwhelming majority) and any
    // caller acting on their own content never trigger a get() here at all —
    // only a genuine alias acting on its primary's docs pays for one document
    // read (repeat get()s of the same path are cached within one evaluation).
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // The caller's primaryUid, or '' when they aren't an alias. Only call this
    // AFTER the cheap `uid == request.auth.uid` check has already failed.
    function callerPrimaryUid() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'primaryUid' in callerDoc()
        && callerDoc().primaryUid is string
        ? callerDoc().primaryUid
        : '';
    }
    // The uid this caller effectively acts as: their primary if they're an alias,
    // else themselves.
    function actingUid() {
      return callerPrimaryUid() == '' ? request.auth.uid : callerPrimaryUid();
    }
    // True when `uid` is one of the caller's linked accounts (self, or — for an
    // alias login — the primary it points at). Cheap check first.
    function isLinkedUid(uid) {
      return request.auth != null
        && uid is string
        && (uid == request.auth.uid || uid == callerPrimaryUid());
    }
    // True when the caller is an ALIAS of `uid` (i.e. `uid` is their primary).
    // Used to let an alias read/write the primary's engagement subcollections.
    function isAliasOf(uid) {
      return request.auth != null
        && uid != request.auth.uid
        && uid == callerPrimaryUid();
    }

    // Chat messages — public read/write for broadcast rooms, auth required for DJ rooms
    match /chats/{stationId}/messages/{messageId} {
      allow read, write: if stationId == 'broadcast' || stationId == 'channelbroadcast';
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Username registration (mobile app)
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 20;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // Allow updates only for claiming reserved usernames (server-side via admin SDK)
      allow update: if false;
    }

    // @Channel mentions log (mobile app)
    match /channel-mentions/{mentionId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Pending popularity emails (for account deletion)
    match /pendingPopularityEmails/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // Pending mention emails (for account deletion)
    match /pendingMentionEmails/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // User profiles and favorites (web app + cron)
    match /users/{userId} {
      // Users can read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Public read for DJ profiles (needed for /dj/[username] pages, DJ lists,
      // search). Kept ABOVE the alias rule below: `allow` rules are OR'd and
      // short-circuit on the first grant, and this one costs ZERO document
      // accesses. If the alias rule came first, every foreign DJ doc returned by
      // a list/search would fall through to its callerPrimaryUid() get() — one
      // extra read PER DOC, since the rules cache is per-evaluation.
      allow read: if resource.data.role in ['dj', 'broadcaster', 'admin'];
      // Cron job access
      allow read: if request.auth != null && request.auth.token.email == 'cron@channel-app.com';
      allow update: if request.auth != null && request.auth.token.email == 'cron@channel-app.com';

      // Linked accounts: an ALIAS may read/write its PRIMARY's doc — the profile
      // is shared, so the alias login loads it (useLinkedIdentity/useUserProfile)
      // and edits to bio/photo/links must land on the one canonical doc. (Only in
      // this direction: a primary is NOT granted access to its aliases' docs.)
      //
      // COST: callerPrimaryUid() costs a get() on the caller's own user doc, so
      // this must never be reachable on a hot path. The Firestore docs do NOT
      // promise that OR'd `allow` rules short-circuit once one grants, so we
      // cannot rely on rule ORDER to protect the DJ-list reads above — instead
      // each branch's own `&&` chain (which CEL DOES short-circuit) is written so
      // the get() is unreachable for ordinary traffic:
      //   - READ is gated on the target NOT being a DJ doc. Every DJ-list /
      //     search / profile read hits `role in [...]` and bails before the
      //     get(). Only an alias reading its non-DJ primary pays.
      //   - WRITE can't use that trick (a DJ primary must stay writable), but
      //     writes to someone else's doc are rare and never in a list query.
      allow read: if request.auth != null
        && userId != request.auth.uid
        && !(resource.data.role in ['dj', 'broadcaster', 'admin'])
        && userId == callerPrimaryUid();
      allow write: if request.auth != null
        && userId != request.auth.uid
        && userId == callerPrimaryUid();

      // Engagement subcollections. An ALIAS is only a login: all of a person's
      // activity is recorded on their PRIMARY, so an alias must be able to
      // read/write the primary's engagement docs. Without the alias branch here
      // the client-side favorite/heart writes would be DENIED and the signal
      // silently lost. (isAliasOf() puts the cheap self-check first, so an
      // ordinary user never triggers a document read.)
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAliasOf(userId);
        allow read, write: if request.auth != null && request.auth.token.email == 'cron@channel-app.com';
      }

      // Stream history (written by admin SDK, read-only for owner)
      match /streamHistory/{archiveId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow read: if isAliasOf(userId);
        // Cron job: go-live emails match recipients by engagement (streamed
        // the live/related DJ). Without this, collection-group queries 403 and
        // every engagement-based recipient is silently dropped.
        allow read: if request.auth != null && request.auth.token.email == 'cron@channel-app.com';
      }

      // Love history (written and read by owner)
      match /loveHistory/{djId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAliasOf(userId);
        // Cron job: go-live emails match recipients by engagement (hearted the
        // live/related DJ). Same 403 problem as streamHistory above.
        allow read: if request.auth != null && request.auth.token.email == 'cron@channel-app.com';
      }

      // Tracklist views + played slots are admin-SDK writes only (the server
      // already resolves alias→primary), so they need no client rule here.
    }

    // Broadcast slots
    // - Anyone can read (DJs validate their token without login)
    // - Broadcasters/admins can create/delete and update any field
    // - The assigned DJ can update only showName / showImageUrl on their own slot
    //   (matched by uid via djUserId/liveDjUserId, or by lowercased email via djEmail)
    match /broadcast-slots/{slotId} {
      allow read: if true;
      allow create, delete: if isBroadcaster();
      allow update: if isBroadcaster()
        || (
          request.auth != null
          && (
            // Any of the DJ's linked accounts (self or primary) counts as the
            // assigned DJ, so a slot booked under either account is editable
            // from either login.
            isLinkedUid(resource.data.djUserId)
            || isLinkedUid(resource.data.liveDjUserId)
            || (
              resource.data.djEmail is string
              && request.auth.token.email is string
              && resource.data.djEmail.lower() == request.auth.token.email.lower()
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['showName', 'showImageUrl'])
        );
    }

    // DJ applications (web app)
    // - Anyone can create (public application form)
    // - Only broadcasters/admins can read and update
    match /dj-applications/{docId} {
      allow create: if true;
      allow read, update: if isBroadcaster();
      allow delete: if false;
    }

    // Pending DJ profiles (for pre-registered DJs who haven't signed up yet)
    // - Anyone can read (needed for DJ profile pages)
    // - Only broadcasters/admins can write
    match /pending-dj-profiles/{profileId} {
      allow read: if true;
      allow write: if isBroadcaster();
    }

    // Events (admin-managed)
    // - Anyone can read (needed for public event display)
    // - Only broadcasters/admins can write
    match /events/{eventId} {
      allow read: if true;
      allow write: if isBroadcaster();
    }

    // Venues are no longer an entity — a venue is free text typed on an event.
    // The legacy `venues` collection is orphaned (nothing reads or writes it),
    // so it gets no rule: reads and writes are denied by default.

    // Collectives (admin-managed + owner self-service)
    // - Anyone can read (needed for public collective pages)
    // - Broadcasters/admins can write anything
    // - OWNERS may self-edit ONLY cosmetic display fields on collectives they
    //   own (slug ∈ their ownedCollectiveSlugs, kept in sync by
    //   /api/admin/collectives). The hasOnly() whitelist keeps owners OUT of
    //   name/slug/owners/residentDJs/guestDJs/sceneIds/linked* — those stay
    //   admin- or owner-API-only. This mirrors the archives tracklist rule.
    match /collectives/{collectiveId} {
      allow read: if true;
      allow write: if isBroadcaster();
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.ownedCollectiveSlugs is list
        && (resource.data.slug in
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.ownedCollectiveSlugs)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['photo', 'description', 'location', 'genres', 'socialLinks', 'tipButtonLink']);
    }

    // Scheduled notifications (cron job)
    match /scheduledNotifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'cron@channel-app.com';
    }

    // Archives (recordings and broadcast archives)
    // - Anyone can read (needed for /archives, /dj/[username] pages)
    // - DJs can update/delete their own UPLOADED recordings (owned via
    //   uploadedBy) — full field access for studio ops (name, image, publish).
    // - DJs can edit ONLY the tracklist (trackIds) on archives they are the
    //   primary credited DJ of (djs[0].userId). This covers LIVE recordings,
    //   which carry no uploadedBy — the owner lives in djs[]. Scoped to
    //   trackIds so a DJ can't rewrite recordingUrl / priority / djs / etc.
    // - Collective OWNERS can likewise edit ONLY trackIds on their collective's
    //   archives (credited via djs[0].username == <collective slug>). We read
    //   the editor's own user doc — ownedCollectiveSlugs, kept in sync by
    //   /api/admin/collectives — so any owner of a multi-owner collective works.
    match /archives/{archiveId} {
      allow read: if true;
      allow update: if request.auth != null
        && (
          // Uploaded-recording owner: full update. Accepts any of the DJ's
          // linked accounts, so an alias login can manage the primary's uploads.
          isLinkedUid(resource.data.uploadedBy)
          // Credited primary DJ: tracklist-only update (covers live recordings).
          || (
            resource.data.djs is list
            && resource.data.djs.size() > 0
            && isLinkedUid(resource.data.djs[0].userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['trackIds'])
          )
          // Collective owner: tracklist-only update on the collective's archives.
          // Reads ownedCollectiveSlugs off the ACTING user (the primary for an
          // alias login), since linking fans collective rights onto the primary.
          || (
            resource.data.djs is list
            && resource.data.djs.size() > 0
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['trackIds'])
            && exists(/databases/$(database)/documents/users/$(actingUid()))
            && get(/databases/$(database)/documents/users/$(actingUid()))
                 .data.ownedCollectiveSlugs is list
            && (resource.data.djs[0].username in
                get(/databases/$(database)/documents/users/$(actingUid()))
                  .data.ownedCollectiveSlugs)
          )
        );
      allow delete: if request.auth != null
        && isLinkedUid(resource.data.uploadedBy)
        && resource.data.sourceType != 'live';
    }

    // Continuous archive radio schedule. Public read so /radio/demo can
    // subscribe and play back the day's queue. Writes only go through the
    // admin SDK (cron + admin endpoints), so client writes stay denied.
    match /archive-schedule/{date} {
      allow read: if true;
      allow write: if false;
    }

    // Catalog-loop variant of the archive radio. Replaces archive-schedule
    // long-term: doc id = `loop-NNNN`, each doc is one full pass through the
    // catalog. Public read so /radio/demo can subscribe; writes through admin.
    match /archive-radio-loop/{loopId} {
      allow read: if true;
      allow write: if false;
    }

    // Interstitial audio metadata for the archive radio (pool of station
    // idents). Public read so the player can resolve interstitial titles;
    // writes go through admin SDK.
    match /interstitials/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Tips - anyone can read tips (needed for DJ dashboard to show tip totals)
    // Tips are created only by the server via Stripe webhook
    match /tips/{tipId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Station applications (web app)
    match /station-applications/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Beta waitlist - Android email capture (web app)
    match /beta-waitlist/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Field notes (listener voice notes, admin-approved)
    // The client never reads/writes this collection directly — all access goes
    // through the admin-SDK API routes (which enforce the FIELD_NOTES_ADMIN_ONLY
    // gate). These rules are defense-in-depth. The whole feature is hidden from
    // users by the app-layer flag, so there's no need to keep the rules extra
    // restrictive — published notes are public-readable and authors can read
    // their own (any status), matching the eventual public launch.
    match /field-notes/{noteId} {
      allow read: if resource.data.status == 'published';
      allow read: if request.auth != null && resource.data.recordedByUserId == request.auth.uid;
      allow read, update: if isBroadcaster();
      allow create, delete: if false;
    }
  }
}
